{
  "name": "project-freefall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @freefall/server",
    "dev:client": "npm run dev -w @freefall/client",
    "start:server": "npm run start -w @freefall/server",
    "build": "npm run build -w @freefall/shared && npm run build -w @freefall/server && npm run build -w @freefall/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --conditions=development --test --test-isolation=none apps/server/test/*.test.ts apps/client/test/*.test.ts",
    "benchmark": "node --conditions=development apps/server/src/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2"
  }
}
